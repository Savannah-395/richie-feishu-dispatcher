FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Optional when your app enables encrypted event delivery.
FEISHU_ENCRYPT_KEY=

# OpenAI or an OpenAI-compatible proxy endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

# Reply policy:
# The first message in a Feishu topic must @ richie.
# Follow-up messages in that same topic do not need another @.
BOT_DISPLAY_NAME=richie
BOT_REQUIRE_MENTION_TO_START=true
BOT_REQUIRE_MENTION_TO_REPLY=false
BOT_ALLOWED_CHAT_IDS=
BOT_ACK_EMOJI_TYPE=OnIt
BOT_DONE_EMOJI_TYPE=DONE
BOT_MAX_THREAD_MESSAGES=20
BOT_MAX_INPUT_CHARS=12000
BOT_SYSTEM_PROMPT=你是 richie，是一个在飞书群话题内回复问题的助手。只基于当前话题的上下文回答，不要引用其他话题。回答要直接、准确、简洁。

# Runtime encoding. Required on Windows so Python/Codex output keeps Chinese text intact.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Audit group. Keep the real chat ID in local .env only.
RICHIE_AUDIT_ENABLED=false
RICHIE_AUDIT_CHAT_ID=
RICHIE_AUDIT_MAX_MESSAGE_CHARS=2000

# GitHub-backed richie skill sync.
# richie-feishu-dispatcher is only the runner repo.
# Business projects should be separate GitHub repos under the same owner/org.
RICHIE_GIT_SYNC_ENABLED=true
RICHIE_GIT_SYNC_INTERVAL_SECONDS=600
RICHIE_GIT_REMOTE=origin
RICHIE_GIT_BRANCH=
RICHIE_PROJECT_ROOTS=..
RICHIE_GITHUB_PROJECT_OWNER=Savannah-395
RICHIE_GITHUB_AUTO_DISCOVER_PROJECT_REPOS=true
RICHIE_GITHUB_PROJECT_REPOS=
RICHIE_GITHUB_PROJECT_CLONE_ROOT=..
RICHIE_INSTALL_CODEX_SKILLS=true
RICHIE_CODEX_SKILLS_DIR=
RICHIE_SKILL_PREFIX=

# Optional for private repo discovery if Git Credential Manager is not available.
# Do not commit real tokens.
GITHUB_TOKEN=

# Codex CLI mode.
BOT_CODEX_ENABLED=true
BOT_CODEX_PREFIX=/codex
BOT_CODEX_FULL_ACCESS_PREFIXES=/电脑,/full
BOT_CODEX_FULL_ACCESS_ALLOWED_SENDER_IDS=
BOT_CODEX_FULL_ACCESS_ROOT=
BOT_CODEX_FULL_ACCESS_SANDBOX=danger-full-access
BOT_CODEX_MODEL=
BOT_CODEX_SANDBOX=workspace-write
BOT_CODEX_TIMEOUT_SECONDS=600
